# Copia este fichero a .env. La app lo carga al arrancar (python-dotenv).
# Todos los proveedores se configuran aquí, sea cual sea el que uses.

# --- Cadena de proveedores -------------------------------------------------
# Proveedor principal: anthropic | openai | gemini | custom
LLM_PROVIDER=anthropic

# Orden de respaldo si el principal falla (sin clave, rate limit, caída, error
# de la API). Si comentas esta línea, se usan automáticamente todos los demás
# proveedores que tengan credenciales, en el orden: anthropic, openai, gemini, custom.
LLM_FALLBACKS=gemini,openai
# Cada entrada admite `proveedor:modelo` para fijar el modelo de ese eslabón.
# Útil para encadenar dos modelos del mismo proveedor (uno nuevo y su anterior
# estable como red de seguridad):
#   LLM_FALLBACKS=gemini:gemini-3.5-flash,openai

# Reintentos ante errores transitorios (429, 503, 5xx, timeouts) antes de pasar
# al siguiente eslabón. Súbelo si tu proveedor va justo de cuota; bájalo a 0 si
# prefieres saltar de eslabón cuanto antes.
LLM_MAX_RETRIES=1
LLM_RETRY_DELAY=1.5

# --- Claude (Anthropic) ----------------------------------------------------
ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-opus-5
# ANTHROPIC_BASE_URL=https://api.anthropic.com

# --- OpenAI ----------------------------------------------------------------
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-5.5
# OPENAI_BASE_URL=https://api.openai.com/v1

# --- Google Gemini ---------------------------------------------------------
GEMINI_API_KEY=...
GEMINI_MODEL=gemini-3.8-flash

# --- Endpoint compatible con OpenAI ---------------------------------------
# OpenRouter, Groq, Together, DeepSeek, vLLM, Ollama… Usa Chat Completions con
# JSON Schema, así que el modelo debe soportar `response_format`.
# CUSTOM_BASE_URL=https://openrouter.ai/api/v1
# CUSTOM_API_KEY=...
# CUSTOM_MODEL=meta-llama/llama-4-70b-instruct

# --- Tarifas opcionales ----------------------------------------------------
# Solo se estima coste si hay tarifa conocida (Claude) o configurada aquí.
# Valores en USD por millón de tokens.
# OPENAI_PRICE_IN=1.25
# OPENAI_PRICE_OUT=10
# GEMINI_PRICE_IN=0.30
# GEMINI_PRICE_OUT=2.50
# CUSTOM_PRICE_IN=0
# CUSTOM_PRICE_OUT=0
